rules_version = '2';

// ข้อมูลผู้ใช้อยู่ที่ users/{uid} — uid มาจาก Firebase Auth ผู้ใช้ปลอมไม่ได้
// admin = บัญชีที่มีเอกสาร admins/{uid} — คนแรกเพิ่มจาก Firebase Console, คนต่อไป admin เพิ่มจากหน้า /admin
// path อื่นที่ไม่ได้เขียนไว้ถูกปฏิเสธทั้งหมด
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    function optString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // ผลแบบทดสอบก่อน/หลังเรียน { score, total, at }
    function validScore(s) {
      return s is map && s.keys().hasOnly(['score', 'total', 'at'])
        && s.total is int && s.total > 0 && s.total <= 100
        && s.score is int && s.score >= 0 && s.score <= s.total
        && s.at is string && s.at.size() <= 40;
    }

    // ผลประเมินความเสี่ยง { totalRisk, level, factors: [id ข้อที่ตอบใช่], at }
    function validAssessment(a) {
      return a is map && a.keys().hasOnly(['totalRisk', 'level', 'factors', 'at'])
        && a.totalRisk is int && a.totalRisk >= 0 && a.totalRisk <= 100
        && a.level in ['low', 'medium', 'high']
        && a.factors is list && a.factors.size() <= 20
        && a.at is string && a.at.size() <= 40;
    }

    // ผลแบบประเมินแต่ละชุดเก็บ 2 ฟิลด์: <ชื่อ> = ครั้งล่าสุด (ทับได้), <ชื่อ>First = ครั้งแรก (เขียนครั้งเดียว ดู firstResultsKept)
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'age', 'gestationalWeeks', 'gravida', 'expectedDeliveryDate', 'createdAt', 'satisfaction', 'preTest', 'postTest', 'assessment', 'satisfactionFirst', 'preTestFirst', 'postTestFirst', 'assessmentFirst'])
        && optString(d, 'name', 100)
        && optString(d, 'age', 10)
        && optString(d, 'gestationalWeeks', 10)
        && optString(d, 'gravida', 10)
        && optString(d, 'expectedDeliveryDate', 30)
        && optString(d, 'createdAt', 40)
        && (!('satisfaction' in d) || (d.satisfaction is map && d.satisfaction.size() <= 50))
        && (!('preTest' in d) || validScore(d.preTest))
        && (!('postTest' in d) || validScore(d.postTest))
        && (!('assessment' in d) || validAssessment(d.assessment))
        && (!('satisfactionFirst' in d) || (d.satisfactionFirst is map && d.satisfactionFirst.size() <= 50))
        && (!('preTestFirst' in d) || validScore(d.preTestFirst))
        && (!('postTestFirst' in d) || validScore(d.postTestFirst))
        && (!('assessmentFirst' in d) || validAssessment(d.assessmentFirst));
    }

    // "ครั้งแรก" เขียนได้ครั้งเดียว: ถ้ามีอยู่แล้ว ต้องไม่ถูกแก้หรือลบ (กันทับแม้บันทึกพร้อมกันจาก 2 เครื่อง)
    function firstKept(old, d, key) {
      return !(key in old) || (key in d && d[key] == old[key]);
    }
    function firstResultsKept(old, d) {
      return firstKept(old, d, 'satisfactionFirst') && firstKept(old, d, 'preTestFirst')
        && firstKept(old, d, 'postTestFirst') && firstKept(old, d, 'assessmentFirst');
    }

    function validBP(d) {
      return d.keys().hasOnly(['systolic', 'diastolic', 'timestamp', 'isHighRisk'])
        && d.systolic is int && d.systolic >= 40 && d.systolic <= 300
        && d.diastolic is int && d.diastolic >= 20 && d.diastolic <= 200
        && d.timestamp is string && d.timestamp.size() <= 40
        // ต้องตรงกับเกณฑ์ใน isHighBP (src/lib/healthLogs.ts) — กันซ่อนค่าความดันสูงจากหน้า admin
        && d.isHighRisk == (d.systolic >= 140 || d.diastolic >= 90);
    }

    // admin เพิ่ม/ลบ admin คนอื่นจากหน้า /admin ได้ แต่ลบตัวเองไม่ได้ จึงเหลือ admin อย่างน้อย 1 คนเสมอ
    // admin คนแรกเพิ่มจาก Firebase Console
    function validWeight(d) {
      return d.keys().hasOnly(['kg', 'timestamp'])
        && d.kg is number && d.kg >= 20 && d.kg <= 250
        && d.timestamp is string && d.timestamp.size() <= 40;
    }

    // ลูกดิ้นรายวัน: id เอกสาร = วันที่ (YYYY-MM-DD), count เพิ่ม/ลดด้วย increment
    function validKicks(d, dayId) {
      return d.keys().hasOnly(['count', 'date', 'updatedAt'])
        && d.count is int && d.count >= 0 && d.count <= 1000
        && d.date == dayId && dayId.size() == 10
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }

    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin(); // ให้หน้า /admin เช็คสิทธิ์ของตัวเองได้
      allow list: if isAdmin();
      allow create: if isAdmin()
        && userId.size() <= 128
        && request.resource.data.keys().hasOnly(['name', 'addedBy', 'addedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt is string && request.resource.data.addedAt.size() <= 40;
      allow delete: if isAdmin() && userId != request.auth.uid;
      allow update: if false;
    }

    // หน้า admin ดึงบันทึกสุขภาพของทุกคนทีเดียว (collection group query)
    match /{path=**}/bloodPressures/{logId} {
      allow read: if isAdmin();
    }
    match /{path=**}/weights/{logId} {
      allow read: if isAdmin();
    }
    match /{path=**}/kicks/{dayId} {
      allow read: if isAdmin();
    }

    // เจ้าของลบข้อมูลตัวเองไม่ได้ — admin ทุกคนลบบัญชีผู้ใช้ (โปรไฟล์ + log) ได้จากหน้า /admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validProfile(request.resource.data);
      allow update: if isOwner(userId) && validProfile(request.resource.data) && firstResultsKept(resource.data, request.resource.data);
      allow delete: if isAdmin();

      match /bloodPressures/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        // update = แก้ค่าที่บันทึกผิดของตัวเอง
        allow create, update: if isOwner(userId) && validBP(request.resource.data);
        allow delete: if isAdmin();
      }

      match /weights/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validWeight(request.resource.data);
        allow delete: if isAdmin();
      }

      match /kicks/{dayId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validKicks(request.resource.data, dayId);
        allow delete: if isAdmin();
      }
    }
  }
}
